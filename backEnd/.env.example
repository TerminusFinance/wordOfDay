# ===========================================
# Word of Day - Environment Variables
# ===========================================
# Copy this file to .env and fill in your values
# Never commit your actual .env file to the repository

# Telegram Bot Configuration
MY_SECRET_TOKEN=your_telegram_bot_token_here

# Database Configuration
DB_HOST=localhost
DB_USER=your_database_username
DB_PASSWORD=your_database_password
DB_NAME=wordOfDay
DB_PORT=3306

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Application Configuration
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# Redis Configuration (if using)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Security
JWT_SECRET=your_jwt_secret_here
ENCRYPTION_KEY=your_encryption_key_here

# Monitoring (optional)
SENTRY_DSN=your_sentry_dsn_here

# ===========================================
# IMPORTANT SECURITY NOTES:
# 1. Never commit your actual .env file
# 2. Use strong, unique passwords
# 3. Rotate API keys regularly
# 4. Use different values for production
# ===========================================